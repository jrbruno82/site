<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Broker Dashboard - Cenários Pro v1.15</title>
    <meta name="description" content="Dashboard de análise técnica, dividendos e cenários de swing trade com dados em tempo real.">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js" integrity="sha384-JUh163oCRItcbPme8pYnROHQMC6fNKTBWtRG3I3I0erJkzNgL7uxKlNwcrcFKeqF" crossorigin="anonymous"></script>
    <style>
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #111827; }
        ::-webkit-scrollbar-thumb { background: #374151; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #4B5563; }
        .tab-btn.active { background-color: #3B82F6; color: white; border-color: #3B82F6; }
        .nav-tab.active { background-color: #2563EB; color: white; border-color: #3B82F6; }
        .toggle-checkbox:checked { right: 0; border-color: #3B82F6; }
        .toggle-checkbox:checked + .toggle-label { background-color: #3B82F6; }
        input[type="color"]::-webkit-color-swatch-wrapper { padding: 0; }
        input[type="color"]::-webkit-color-swatch { border: none; border-radius: 4px; }
        .loader-spin { animation: spin 1s linear infinite; }
        @keyframes spin { 100% { transform: rotate(360deg); } }
    </style>
</head>
<body class="bg-gray-900 text-gray-100 font-sans antialiased min-h-screen p-4 md:p-6">

    <div class="max-w-7xl mx-auto space-y-6">
        
        <!-- Cabeçalho Fixo (Sticky) -->
        <header class="sticky top-2 z-50 flex flex-col md:flex-row justify-between items-start md:items-center bg-gray-800/95 backdrop-blur-md p-4 rounded-xl shadow-[0_10px_40px_-10px_rgba(0,0,0,0.5)] border border-gray-700">
            <div class="flex items-center gap-3 mb-4 md:mb-0">
                <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center font-bold text-xl shadow-blue-500/50 shadow-lg">HB</div>
                <h1 class="text-2xl font-bold tracking-wide">Nexus<span class="text-blue-500">Broker</span> <span class="text-xs bg-blue-900 text-blue-300 px-2 py-1 rounded-full ml-2">PRO</span> <span class="inline-flex flex-col ml-1 align-top"><span class="text-[10px] text-purple-400 font-mono tracking-tighter" title="Versão Atualizada">v1.15</span><span class="text-[10px] text-purple-400 font-mono tracking-tighter leading-none mt-0.5">by Junior Bruno</span></span></h1>
            </div>
            
            <div class="flex flex-wrap items-center gap-3">
                <div class="flex flex-col">
                    <div class="flex items-center gap-2">
                        <label for="tickerSelect" class="text-gray-400 font-medium">Ativo:</label>
                        <select id="tickerSelect" class="bg-gray-900 border border-gray-600 text-white font-bold py-2 px-4 rounded-lg focus:outline-none focus:border-blue-500 transition-colors cursor-pointer">
                            <option value="">Carregando...</option>
                        </select>
                    </div>
                    <!-- Nome da Empresa Exibido Dinamicamente via Internet -->
                    <div class="flex gap-2 mt-1 pl-11">
                        <span id="company-name-badge" class="text-[11px] text-blue-400 font-bold hidden"></span>
                        <span id="currency-badge" class="bg-gray-700 text-gray-300 text-[10px] px-1.5 py-0.5 rounded font-bold hidden uppercase tracking-wider"></span>
                    </div>
                </div>
                
                <button id="refreshBtn" class="bg-gray-900 hover:bg-gray-700 border border-gray-600 p-2 rounded-lg transition-colors cursor-pointer self-start md:self-auto mt-1" title="Atualizar dados">
                    <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                </button>

                <button onclick="openScenarioModal()" class="bg-green-600 hover:bg-green-500 text-white font-bold px-4 py-2 rounded-lg shadow-lg transition-all flex items-center gap-2 cursor-pointer self-start md:self-auto mt-1">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    Criar Cenário (R$ 100)
                </button>

                <div id="loading" class="hidden text-sm font-bold text-blue-400 animate-pulse bg-blue-900/30 px-3 py-1 rounded-full self-start md:self-auto mt-1">Atualizando Dados...</div>
            </div>
        </header>

        <!-- Selo de origem/qualidade dos dados -->
        <div id="data-status" role="status" class="rounded-xl border px-4 py-3 flex flex-wrap items-center gap-x-4 gap-y-2 bg-gray-800 border-gray-700">
            <span id="data-status-badge" class="font-black text-xs px-2.5 py-1 rounded border whitespace-nowrap bg-gray-700 text-gray-300 border-gray-600">CARREGANDO...</span>
            <span id="data-status-text" class="text-xs text-gray-300"></span>
        </div>

        <!-- Navegação de Abas Principais -->
        <div class="flex border-b border-gray-700 gap-2 overflow-x-auto" role="tablist" aria-label="Seções do dashboard">
            <button onclick="switchMainTab('tech')" id="btn-tab-tech" role="tab" aria-selected="true" aria-controls="section-tech" class="nav-tab active px-5 py-2.5 rounded-t-lg font-bold text-sm transition-colors border-t border-x border-gray-700 cursor-pointer whitespace-nowrap">
                📊 Gráfico & Análise Técnica
            </button>
            <button onclick="switchMainTab('dividends')" id="btn-tab-dividends" role="tab" aria-selected="false" aria-controls="section-dividends" class="nav-tab px-5 py-2.5 rounded-t-lg font-bold text-sm transition-colors border-t border-x border-gray-700 text-gray-400 hover:text-white cursor-pointer flex items-center gap-2 whitespace-nowrap">
                💰 Dividendos & Rendimentos
            </button>
            <button onclick="switchMainTab('news')" id="btn-tab-news" role="tab" aria-selected="false" aria-controls="section-news" class="nav-tab px-5 py-2.5 rounded-t-lg font-bold text-sm transition-colors border-t border-x border-gray-700 text-gray-400 hover:text-white cursor-pointer flex items-center gap-2 whitespace-nowrap">
                📰 Notícias & Calendário
                <span id="ticker-badge-news" class="bg-blue-900 text-blue-300 text-xs px-2 py-0.5 rounded-full">Ativo</span>
            </button>
            <!-- Nova Aba Estratégias -->
            <button onclick="switchMainTab('strategy')" id="btn-tab-strategy" role="tab" aria-selected="false" aria-controls="section-strategy" class="nav-tab px-5 py-2.5 rounded-t-lg font-bold text-sm transition-colors border-t border-x border-gray-700 text-gray-400 hover:text-white cursor-pointer flex items-center gap-2 whitespace-nowrap">
                🎯 Estratégias (Curto Prazo)
            </button>
        </div>

        <!-- CONTEÚDO DA ABA 1: TÉCNICO -->
        <div id="section-tech" class="space-y-6">
            <!-- Indicadores (KPIs) -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-gray-800 p-4 rounded-xl border border-gray-700 shadow-md flex flex-col justify-center">
                    <p class="text-gray-400 font-medium mb-1 uppercase tracking-wider text-[11px] md:text-xs">
                        Último Fech. <span id="kpi-date" class="text-blue-400 font-bold ml-1"></span>
                    </p>
                    <p id="kpi-close" class="text-2xl font-bold text-white transition-all">0,00</p>
                    <p id="kpi-maxmin-pct" class="text-[11px] font-medium mt-1"></p>
                </div>
                <div class="bg-gray-800 p-4 rounded-xl border border-gray-700 shadow-md flex flex-col justify-center">
                    <p class="text-gray-400 font-medium mb-1 uppercase tracking-wider text-[11px] md:text-xs">Abertura (Período)</p>
                    <p id="kpi-open" class="text-2xl font-bold text-white transition-all">0,00</p>
                </div>
                <div class="bg-gray-800 p-4 rounded-xl border border-gray-700 shadow-md flex flex-col justify-center">
                    <p class="text-gray-400 font-medium mb-1 uppercase tracking-wider text-[11px] md:text-xs">
                        Máxima (Fech.) <span id="kpi-high-date" class="text-green-500 font-bold ml-1"></span>
                    </p>
                    <p id="kpi-high" class="text-2xl font-bold text-green-400 transition-all">0,00</p>
                </div>
                <div class="bg-gray-800 p-4 rounded-xl border border-gray-700 shadow-md flex flex-col justify-center">
                    <p class="text-gray-400 font-medium mb-1 uppercase tracking-wider text-[11px] md:text-xs">
                        Mínima (Fech.) <span id="kpi-low-date" class="text-red-500 font-bold ml-1"></span>
                    </p>
                    <p id="kpi-low" class="text-2xl font-bold text-red-400 transition-all">0,00</p>
                </div>
            </div>

            <!-- Painel de Análise e Swing Trade -->
            <div class="grid grid-cols-1 xl:grid-cols-4 gap-4">
                <div class="col-span-1 bg-gray-800 p-5 rounded-xl border border-gray-700 shadow-lg flex flex-col justify-between">
                    <div>
                        <h3 class="text-gray-400 text-xs font-bold uppercase tracking-wider mb-2">Recomendação Algorítmica</h3>
                        <div id="expert-badge" class="inline-block px-4 py-2 rounded-lg text-xl font-bold bg-gray-700 text-white mb-4">
                            AGUARDANDO...
                        </div>
                        <p id="expert-reason" class="text-sm text-gray-300 leading-relaxed mb-3">
                            Analisando os dados técnicos do ativo...
                        </p>
                        <div id="recommendation-timestamp" class="text-[11px] text-blue-400 font-mono bg-blue-950/40 p-2 rounded border border-blue-900/30">
                            Última análise: --/--/---- --:--:--
                        </div>
                    </div>
                    <div class="mt-4 pt-4 border-t border-gray-700">
                        <p class="text-xs text-gray-500">Decisão: MME (9/21/200), rompimento de pivô e IFR. Bandas de Bollinger, candlestick, volume, tendência e Monte Carlo são formativos e complementares.</p>
                    </div>
                </div>

                <!-- Radar Swing Trade -->
                <div class="col-span-1 xl:col-span-3 bg-gray-800 p-5 rounded-xl border border-gray-700 shadow-lg flex flex-col">
                    <h3 class="text-gray-400 text-xs font-bold uppercase tracking-wider mb-4 flex items-center gap-2">
                        <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                        Gerenciamento de Risco & Análise Gráfica
                    </h3>
                    
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 flex-grow">
                        <!-- Níveis de Preço e Stop Loss -->
                        <div class="bg-gray-900/50 p-3 rounded-lg border border-gray-700/50">
                            <p class="text-[11px] text-gray-400 mb-1 uppercase font-bold" title="Piso onde o preço tende a parar de cair">🧱 Suporte & Stop Loss</p>
                            <p id="dt-support" class="text-lg font-bold text-green-400">0,00</p>
                            <p class="text-[10px] text-gray-400 mt-1">Stop Loss Ideal: <span id="dt-stop-loss" class="text-red-400 font-bold">0,00</span></p>
                        </div>
                        <div class="bg-gray-900/50 p-3 rounded-lg border border-gray-700/50">
                            <p class="text-[11px] text-gray-400 mb-1 uppercase font-bold" title="Teto onde o preço tende a parar de subir">🧱 Resistência & Alvo</p>
                            <p id="dt-resistance" class="text-lg font-bold text-red-400">0,00</p>
                            <p class="text-[10px] text-gray-400 mt-1">Stop Gain (Alvo): <span id="dt-stop-gain" class="text-green-400 font-bold">0,00</span></p>
                        </div>
                        
                        <!-- Candlestick -->
                        <div class="bg-gray-900/50 p-3 rounded-lg border border-gray-700/50">
                            <p class="text-[11px] text-gray-400 mb-1 uppercase font-bold">🕯️ Padrão Candlestick</p>
                            <p id="dt-candle-pattern" class="text-sm font-bold text-gray-200 mt-1">Analisando...</p>
                        </div>

                        <!-- LTA / LTB -->
                        <div class="bg-gray-900/50 p-3 rounded-lg border border-gray-700/50">
                            <p class="text-[11px] text-gray-400 mb-1 uppercase font-bold">📏 Linha de Tendência</p>
                            <p id="dt-trend-status" class="text-sm font-bold text-blue-400 mt-1">Neutro</p>
                            <p id="dt-trend-detail" class="text-[10px] text-gray-400 mt-1"></p>
                        </div>

                        <!-- IFR / RSI -->
                        <div class="bg-gray-900/50 p-3 rounded-lg border border-gray-700/50">
                            <p class="text-[11px] text-gray-400 mb-1 uppercase font-bold" title="Índice de Força Relativa (>70 Sobrecomprado, <30 Sobrevendido)">📊 IFR (14 Períodos)</p>
                            <p id="dt-rsi-val" class="text-lg font-bold text-white">0.00</p>
                            <p id="dt-rsi-status" class="text-[10px] uppercase font-bold mt-0.5 text-gray-400">Neutro</p>
                        </div>

                        <!-- Volume -->
                        <div class="bg-gray-900/50 p-3 rounded-lg border border-gray-700/50">
                            <p class="text-[11px] text-gray-400 mb-1 uppercase font-bold">📉 Volume (Última Sessão)</p>
                            <p id="dt-volume-status" class="text-sm font-bold text-gray-200 mt-1">Analisando...</p>
                            <p id="dt-volume-detail" class="text-[10px] text-gray-400 mt-1"></p>
                        </div>
                    </div>
                    
                    <div class="mt-4 text-sm text-gray-300 bg-blue-900/20 border border-blue-800/30 p-3 rounded-lg flex items-start gap-3" id="dt-insight"></div>
                </div>
            </div>

            <!-- Gráfico e Ferramentas Pro -->
            <div class="bg-gray-800 p-5 rounded-xl border border-gray-700 shadow-lg">
                <div class="flex flex-col xl:flex-row justify-between items-start xl:items-center mb-6 gap-4 border-b border-gray-700 pb-4">
                    <div>
                        <h2 class="text-lg font-bold text-gray-200" id="chart-title">Evolução do Preço</h2>
                        <p class="text-xs text-gray-400 mt-1">Visão técnica e quantitativa (Swing Trade 1D)</p>
                    </div>
                    
                    <div class="flex flex-wrap gap-4 items-center bg-gray-900 p-2 rounded-lg border border-gray-700">
                        <div class="flex items-center gap-2 pr-2 border-r border-gray-700">
                            <label for="chartTypeSelect" class="text-xs font-medium text-gray-400">Exibição:</label>
                            <select id="chartTypeSelect" class="bg-gray-800 border border-gray-600 text-white text-xs font-bold py-1 px-2 rounded focus:outline-none focus:border-blue-500 cursor-pointer">
                                <option value="area" selected>Área (Padrão)</option>
                                <option value="line">Linha</option>
                                <option value="candle">Vela (Candles)</option>
                            </select>
                        </div>

                        <div class="flex items-center gap-3 pr-2 border-r border-gray-700">
                            <label class="flex items-center cursor-pointer gap-2">
                                <div class="relative">
                                    <input type="checkbox" id="togglePeaksTroughs" class="sr-only toggle-checkbox">
                                    <div class="block bg-gray-600 w-10 h-6 rounded-full toggle-label transition-colors"></div>
                                    <div class="dot absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform duration-300"></div>
                                </div>
                                <span class="text-xs font-medium text-gray-300" title="Identificar Topos e Fundos Locais">Topos/Fundos</span>
                            </label>
                            <div class="flex items-center gap-1">
                                <input type="color" id="colorPeak" value="#10B981" class="w-6 h-6 p-0 border-0 rounded cursor-pointer bg-transparent" title="Cor dos Topos (Resistências)">
                                <input type="color" id="colorTrough" value="#EF4444" class="w-6 h-6 p-0 border-0 rounded cursor-pointer bg-transparent" title="Cor dos Fundos (Suportes)">
                            </div>
                        </div>

                        <label class="flex items-center cursor-pointer gap-2 pl-2">
                            <div class="relative">
                                <input type="checkbox" id="toggleMA" class="sr-only toggle-checkbox">
                                <div class="block bg-gray-600 w-10 h-6 rounded-full toggle-label transition-colors"></div>
                                <div class="dot absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform duration-300"></div>
                            </div>
                            <span class="text-xs font-medium text-gray-300" title="Médias Móveis Exponenciais">MME (9/21/200)</span>
                        </label>

                        <label class="flex items-center cursor-pointer gap-2 border-l border-gray-700 pl-4">
                            <div class="relative">
                                <input type="checkbox" id="toggleBB" class="sr-only toggle-checkbox">
                                <div class="block bg-gray-600 w-10 h-6 rounded-full toggle-label transition-colors"></div>
                                <div class="dot absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform duration-300"></div>
                            </div>
                            <span class="text-xs font-medium text-gray-300" title="Modelo de Volatilidade: Bandas de Bollinger (20 períodos, 2 Desvios Padrões)">Bollinger</span>
                        </label>

                        <label class="flex items-center cursor-pointer gap-2 border-l border-gray-700 pl-4">
                            <div class="relative">
                                <input type="checkbox" id="toggleTrend" class="sr-only toggle-checkbox">
                                <div class="block bg-gray-600 w-10 h-6 rounded-full toggle-label transition-colors"></div>
                                <div class="dot absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform duration-300"></div>
                            </div>
                            <span class="text-xs font-medium text-gray-300">Tendência</span>
                        </label>

                        <label class="flex items-center cursor-pointer gap-2 border-l border-gray-700 pl-4">
                            <div class="relative">
                                <input type="checkbox" id="toggleMC" class="sr-only toggle-checkbox">
                                <div class="block bg-gray-600 w-10 h-6 rounded-full toggle-label transition-colors"></div>
                                <div class="dot absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform duration-300"></div>
                            </div>
                            <span class="text-xs font-medium text-purple-400" title="1.000 caminhos simulados (semente fixa). A banda é o intervalo P5–P95 (90% dos caminhos). Não é previsão.">Monte Carlo (10D)</span>
                        </label>

                        <!-- Filtros de Período -->
                        <div class="border-l border-gray-700 pl-4 flex flex-wrap" id="time-filters">
                            <button class="tab-btn px-3 py-1 rounded-l-md text-xs font-medium text-gray-400 hover:text-white transition-all border border-gray-600" data-days="1">1D</button>
                            <button class="tab-btn px-3 py-1 text-xs font-medium text-gray-400 hover:text-white transition-all border-t border-b border-l border-gray-600" data-days="5">5D</button>
                            <button class="tab-btn px-3 py-1 text-xs font-medium text-gray-400 hover:text-white transition-all border-t border-b border-l border-gray-600" data-days="15">15D</button>
                            <button class="tab-btn px-3 py-1 text-xs font-medium text-gray-400 hover:text-white transition-all border-t border-b border-l border-gray-600" data-days="30">1M</button>
                            <button class="tab-btn px-3 py-1 text-xs font-medium text-gray-400 hover:text-white transition-all border-t border-b border-l border-gray-600" data-days="90">3M</button>
                            <button class="tab-btn active px-3 py-1 text-xs font-medium text-gray-400 hover:text-white transition-all border-t border-b border-l border-gray-600" data-days="180">6M</button>
                            <button class="tab-btn px-3 py-1 text-xs font-medium text-gray-400 hover:text-white transition-all border-t border-b border-l border-gray-600" data-days="365">1A</button>
                            <button class="tab-btn px-3 py-1 rounded-r-md text-xs font-medium text-gray-400 hover:text-white transition-all border border-gray-600" data-days="all">Tudo</button>
                        </div>
                    </div>
                </div>

                <div class="relative h-[400px] w-full">
                    <canvas id="mainChart"></canvas>
                    <div id="chart-unavailable" class="hidden absolute inset-0 flex items-center justify-center text-center text-sm text-yellow-400 bg-gray-900/80 rounded-lg p-6">
                        Não foi possível carregar a biblioteca de gráficos (Chart.js). Verifique sua conexão e recarregue a página. Os indicadores numéricos acima continuam válidos.
                    </div>
                </div>
                <p class="text-[11px] text-gray-500 mt-3 leading-relaxed">
                    A análise usa janelas matemáticas fixas &mdash; Bandas de Bollinger (20 períodos), swing 15, tendência 50, volume 20 e Monte Carlo 120 candles &mdash; e <strong class="text-gray-400">não muda com o período exibido no gráfico</strong>.
                </p>
            </div>
        </div>

        <!-- CONTEÚDO DA ABA 2: DIVIDENDOS -->
        <div id="section-dividends" class="hidden space-y-6">
            
            <!-- LOADER DE DIVIDENDOS -->
            <div id="div-loader" class="hidden flex flex-col items-center justify-center py-20 bg-gray-800 rounded-xl border border-gray-700 shadow-lg">
                <svg class="loader-spin h-10 w-10 text-blue-500 mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span class="text-gray-300 font-bold text-sm">Buscando dados institucionais e de mercado (BTG Pactual & Yahoo)...</span>
                <span class="text-gray-500 text-xs mt-2">Acessando API externa para proventos de forma assíncrona.</span>
            </div>

            <!-- CONTEUDO DE DIVIDENDOS -->
            <div id="div-content" class="space-y-6">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="bg-gray-800 p-4 rounded-xl border border-gray-700 shadow-md flex flex-col justify-center">
                        <p class="text-gray-400 font-medium mb-1 uppercase tracking-wider text-[11px] md:text-xs">Dividend Yield</p>
                        <p id="div-yield" class="text-2xl font-bold text-green-400 transition-all">0,00%</p>
                        <p class="text-[11px] font-medium mt-1 text-gray-400">Últimos 12 meses</p>
                    </div>
                    <div class="bg-gray-800 p-4 rounded-xl border border-gray-700 shadow-md flex flex-col justify-center">
                        <p class="text-gray-400 font-medium mb-1 uppercase tracking-wider text-[11px] md:text-xs">Crescimento (5 Anos)</p>
                        <p id="div-growth" class="text-xl font-bold text-gray-500 transition-all" title="Dados como CAGR necessitam de integrações de API Premium">N/D</p>
                        <p class="text-[11px] font-medium mt-1 text-gray-500">Sem API Premium</p>
                    </div>
                    <div class="bg-gray-800 p-4 rounded-xl border border-gray-700 shadow-md flex flex-col justify-center">
                        <p class="text-gray-400 font-medium mb-1 uppercase tracking-wider text-[11px] md:text-xs">Payout</p>
                        <p id="div-payout" class="text-xl font-bold text-gray-500 transition-all">N/D</p>
